ARG COMPOSER_IMAGE=composer:2.10.2
ARG COMPOSER_VERSION=2.10.2
ARG COMPOSER_SHA256=5ee7125f8a30a34d246cefdc0bc85b8a783b28f2aec968994118512350d28027
ARG PHP_FPM_IMAGE=uhub.service.ucloud.cn/techwu/php:8.4-fpm-bookworm
ARG PECL_REDIS_VERSION=6.3.0
ARG PECL_REDIS_SHA256=0d5141f634bd1db6c1ddcda053d25ecf2c4fc1c395430d534fd3f8d51dd7f0b5
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

FROM ${COMPOSER_IMAGE} AS vendor

ARG COMPOSER_VERSION
ARG COMPOSER_SHA256
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

WORKDIR /app

# 不信任基础镜像内可能漂移或损坏的 PHAR；固定官方发布版本并在使用前校验内容。
ADD https://getcomposer.org/download/${COMPOSER_VERSION}/composer.phar /tmp/composer.phar
RUN echo "${COMPOSER_SHA256}  /tmp/composer.phar" | sha256sum -c - \
 && install -m 0755 /tmp/composer.phar /usr/local/bin/composer \
 && rm -f /tmp/composer.phar

RUN composer --version

# Composer 基础镜像可能使用 Alpine 或 Debian，按实际包管理器安装解压工具。
RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        if [ -f /etc/apk/repositories ]; then \
            sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories; \
        fi; \
        apk add --no-cache unzip; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends unzip; \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo 'No supported package manager found for Composer dependencies' >&2; \
        exit 1; \
    fi

ARG COMPOSER_PACKAGIST_MIRROR=
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_MEMORY_LIMIT=-1 \
    COMPOSER_PROCESS_TIMEOUT=2000

RUN if [ -n "${COMPOSER_PACKAGIST_MIRROR}" ]; then \
        composer config -g repo.packagist composer "${COMPOSER_PACKAGIST_MIRROR}"; \
    fi

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --ignore-platform-req=ext-pcntl \
    --classmap-authoritative \
    --no-scripts

COPY . .

RUN composer dump-autoload \
    --no-dev \
    --no-interaction \
    --classmap-authoritative \
    --no-scripts \
 && BROADCAST_CONNECTION=null php artisan package:discover --ansi \
 && rm -f bootstrap/cache/config.php bootstrap/cache/routes*.php

FROM uhub.service.ucloud.cn/techwu/node:25-bookworm-slim AS assets

WORKDIR /app

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

RUN npm config set registry https://registry.npmmirror.com/

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

FROM ${PHP_FPM_IMAGE}

ARG PECL_REDIS_VERSION
ARG PECL_REDIS_SHA256
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

WORKDIR /var/www/html

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
        sed -i 's|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
        sed -i 's|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libonig-dev \
        libpng-dev \
        libpq-dev \
        libsqlite3-dev \
        libzip-dev \
        postgresql-client \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        pdo_sqlite \
        zip \
    && curl -fsSL "https://pecl.php.net/get/redis-${PECL_REDIS_VERSION}.tgz" -o /tmp/redis.tgz \
    && echo "${PECL_REDIS_SHA256}  /tmp/redis.tgz" | sha256sum -c - \
    && pecl install /tmp/redis.tgz \
    && docker-php-ext-enable redis \
    && rm -f /tmp/redis.tgz \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/99-opcache.ini
COPY docker/php/php-docker-overrides.ini /usr/local/etc/php/conf.d/99-overrides.ini
COPY docker/php-fpm/www.conf /usr/local/etc/php-fpm.d/zz-geoflow.conf
COPY docker/entrypoint.prod.sh /usr/local/bin/geoflow-entrypoint-prod

RUN chmod +x /usr/local/bin/geoflow-entrypoint-prod

COPY --from=vendor /app /var/www/html
COPY --from=assets /app/public/build /var/www/html/public/build

# Source files may arrive from a host checkout with restrictive modes (for example 0600).
# PHP-FPM runs as www-data, so keep application code readable without making it writable.
RUN find app config database resources routes -type d -exec chmod 755 {} + \
 && find app config database resources routes -type f -exec chmod 644 {} +

ENTRYPOINT ["/usr/local/bin/geoflow-entrypoint-prod"]
CMD ["php-fpm", "-F"]
